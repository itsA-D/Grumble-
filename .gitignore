# Build and run artifacts
/bin/
/.run/
/.cache/

# Generated Tailwind CSS (rebuilt by `task generate`)
/web/static/app.css
/web/static/app*.css
# Local Tailwind helper executable
/tw.exe

# Local environment (never commit secrets)
.env
.env.*
!.env.example

# Test and coverage output
*.test
*.out
coverage.txt
coverage.html

# Playwright / Node
/node_modules/
/test-results/
/playwright-report/

# Local tool state that may contain credentials
/.jetro/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
