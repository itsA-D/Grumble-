package views

import "grumble/internal/transport/web/views/ui"

// Detail renders one pain with its vote control and related list (FR-DET-1).
templ Detail(page DetailPage) {
	@Layout(page.Page) {
		<div class="mx-auto w-full max-w-6xl flex-1 px-5 pb-20 pt-10 sm:px-8 sm:pt-14">
			<nav aria-label="Breadcrumb" class="meta flex flex-wrap items-center gap-2">
				<a href="/">Explore</a>
				<span aria-hidden="true">/</span>
				<a href={ "/c/" + page.Pain.CategorySlug }>{ page.Pain.CategoryName }</a>
			</nav>

			<div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
				<article>
					<p class="meta flex flex-wrap items-center gap-2">
						<span class="text-sig">Problem</span>
						<span aria-hidden="true">/</span>
						<a href={ "/country/" + page.Pain.CountryCode }>{ page.Pain.CountryName }</a>
						if page.Pain.Seeded {
							@ui.Tag("Seed")
						}
					</p>
					<h1 class="display mt-5 text-[clamp(2.1rem,5vw,4.5rem)]">{ page.Pain.Body }</h1>
					<div class="meta mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
						<span>Urgency <span class="text-sig">{ page.Pain.Urgency }</span></span>
						<span aria-hidden="true">/</span>
						<span>{ countLabel(page.VoteCount, "vote", "votes") }</span>
					</div>
					<div class="mt-8 flex flex-wrap items-center gap-5">
						@VoteButtonView(VoteButton{
							PainID:    page.PainID,
							Voted:     page.Voted,
							VoteCount: page.VoteCount,
							CSRFToken: page.CSRFToken,
						})
						@SaveButtonView(SaveButton{
							PainID:    page.PainID,
							Saved:     page.Pain.Saved,
							CSRFToken: page.CSRFToken,
							ReturnTo:  "/p/" + page.Pain.Slug,
						})
					</div>
				</article>

				<aside class="lg:sticky lg:top-24">
					@ui.Panel() {
						<p class="meta">How ranking works</p>
						<p class="mt-3 text-sm leading-relaxed text-fg-soft">
							Each frustration carries an urgency score built from how often it happens, how much it disrupts life,
							whether someone would pay to fix it, and the votes it collects.
						</p>
						<a href="/submit" class="btn btn-ghost mt-5 w-full">Add your own</a>
					}
				</aside>
			</div>

			if len(page.Related) > 0 {
				<section class="mt-16">
					<div class="flex flex-wrap items-end justify-between gap-3">
						<h2 class="display text-2xl sm:text-3xl">More { page.Pain.CategoryName } frustrations</h2>
						<a href={ "/c/" + page.Pain.CategorySlug } class="meta text-link">View the hub</a>
					</div>
					<div class="mt-5">
						@PainList(page.Related)
					</div>
				</section>
			}
		</div>
	}
}
