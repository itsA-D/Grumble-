package views

import "grumble/internal/transport/web/views/ui"

// Hub is a category or country landing page with ranked pains and an original
// FAQ (FR-HUB-1, FR-SEO-1/3).
templ Hub(page HubPage) {
	@Layout(page.Page) {
		<div class="mx-auto w-full max-w-6xl flex-1 px-5 pb-20 pt-14 sm:px-8 sm:pt-20">
			<header class="max-w-4xl">
				<p class="meta flex items-center gap-2">
					<span class="inline-block h-1.5 w-1.5 bg-sig"></span>
					Public hub
				</p>
				<h1 class="display mt-5 text-[clamp(2.4rem,6vw,5rem)]">{ page.Heading }</h1>
				<p class="mt-6 max-w-2xl text-base leading-relaxed text-fg-soft sm:text-lg">{ page.Intro }</p>
			</header>

			<div class="mt-6 flex flex-wrap items-center gap-4">
				<p class="meta normal-case tracking-[0.02em]">
					if page.Count == 1 {
						One frustration has been posted here so far.
					} else if page.Count > 1 {
						{ countLabel(page.Count, "frustration", "frustrations") } posted here so far.
					} else {
						No frustrations have been posted here yet.
					}
				</p>
				if !page.Indexable {
					<p class="meta normal-case tracking-[0.02em] text-fg-soft">
						This page is still growing, so it is not listed in search engines yet.
					</p>
				}
			</div>

			<section class="mt-10">
				if len(page.Cards) == 0 {
					@ui.Panel() {
						<p class="p-8 text-center text-sm leading-relaxed text-fg-soft">
							Be the first to describe a frustration here.
							<a href="/submit" class="text-link">Post one.</a>
						</p>
					}
				} else {
					@PainList(page.Cards)
				}
			</section>

			if len(page.FAQ) > 0 {
				<section class="mt-16">
					<h2 class="display text-2xl sm:text-3xl">Questions</h2>
					<dl class="mt-5 grid gap-3 md:grid-cols-2">
						for _, qa := range page.FAQ {
							<div class="panel p-5">
								<dt class="font-display text-base font-semibold tracking-[-0.01em] text-fg">{ qa.Question }</dt>
								<dd class="mt-2 text-sm leading-relaxed text-fg-soft">{ qa.Answer }</dd>
							</div>
						}
					</dl>
				</section>
			}
		</div>
	}
}
