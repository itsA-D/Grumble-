package views

// Hub is a category or country landing page with ranked pains and an original
// FAQ (FR-HUB-1, FR-SEO-1/3).
templ Hub(page HubPage) {
	@Layout(page.Page) {
		@SiteHeader(page.Page)
		<main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 py-10">
			<header class="max-w-3xl">
				<h1 class="text-3xl font-bold tracking-tight">{ page.Heading }</h1>
				<p class="mt-3 text-lg text-muted">{ page.Intro }</p>
			</header>

			<p class="mt-4 text-sm text-muted">
				if page.Count == 1 {
					One frustration has been posted here so far.
				} else if page.Count > 1 {
					{ countLabel(page.Count, "frustration", "frustrations") } posted here so far.
				} else {
					No frustrations have been posted here yet.
				}
			</p>

			if !page.Indexable {
				<p class="mt-2 text-sm text-muted">This page is still growing, so it is not listed in search engines yet.</p>
			}

			<section class="mt-8">
				if len(page.Cards) == 0 {
					<p class="rounded-lg border border-dashed border-edge bg-surface p-8 text-center text-muted">
						Be the first to describe a frustration here.
						<a href="/submit" class="text-brand underline underline-offset-4">Post one.</a>
					</p>
				} else {
					@PainList(page.Cards)
				}
			</section>

			if len(page.FAQ) > 0 {
				<section class="mt-12">
					<h2 class="text-lg font-semibold tracking-tight">Questions</h2>
					<dl class="mt-4 flex flex-col gap-4">
						for _, qa := range page.FAQ {
							<div class="rounded-lg border border-edge bg-surface p-5">
								<dt class="font-medium text-ink">{ qa.Question }</dt>
								<dd class="mt-2 text-muted">{ qa.Answer }</dd>
							</div>
						}
					</dl>
				</section>
			}
		</main>
		@SiteFooter()
	}
}
