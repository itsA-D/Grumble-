package views

templ NotFound(page Page) {
	@Layout(page) {
		@SiteHeader(page)
		<main id="main" class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-20">
			<p class="text-sm font-medium uppercase tracking-widest text-brand">404</p>
			<h1 class="mt-4 text-3xl font-bold tracking-tight">Page not found</h1>
			<p class="mt-4 text-muted">The page you were looking for does not exist.</p>
			<a href="/" class="mt-8 inline-block text-brand underline underline-offset-4">Back home</a>
		</main>
		@SiteFooter()
	}
}

// ErrorPage is the shared non-404 error page (rate limit, forbidden, server
// error). It never exposes internal detail.
templ ErrorPage(data ErrorPageData) {
	@Layout(data.Page) {
		@SiteHeader(data.Page)
		<main id="main" class="mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center px-6 py-20">
			<p class="text-sm font-medium uppercase tracking-widest text-brand">{ errorStatusLabel(data.Status) }</p>
			<h1 class="mt-4 text-3xl font-bold tracking-tight">{ data.Heading }</h1>
			<p class="mt-4 text-muted">{ data.Message }</p>
			<a href="/" class="mt-8 inline-block text-brand underline underline-offset-4">Back home</a>
		</main>
		@SiteFooter()
	}
}
