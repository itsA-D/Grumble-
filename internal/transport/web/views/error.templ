package views

import "grumble/internal/transport/web/views/ui"

// NotFound is the 404 page.
templ NotFound(page Page) {
	@Layout(page) {
		<div class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-5 py-20 sm:px-8">
			@ui.Panel() {
				<div class="p-8 sm:p-12">
					<p class="meta text-sig">404</p>
					<h1 class="display mt-4 text-4xl sm:text-5xl">Page not found</h1>
					<p class="mt-5 text-base leading-relaxed text-fg-soft">The page you were looking for does not exist.</p>
					<div class="mt-8">
						@ui.ButtonLink("/", ui.Ghost) {
							Back home
						}
					</div>
				</div>
			}
		</div>
	}
}

// ErrorPage is the shared non-404 error page (rate limit, forbidden, server
// error). It never exposes internal detail.
templ ErrorPage(data ErrorPageData) {
	@Layout(data.Page) {
		<div class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-5 py-20 sm:px-8">
			@ui.Panel() {
				<div class="p-8 sm:p-12">
					<p class="meta text-sig">{ errorStatusLabel(data.Status) }</p>
					<h1 class="display mt-4 text-4xl sm:text-5xl">{ data.Heading }</h1>
					<p class="mt-5 text-base leading-relaxed text-fg-soft">{ data.Message }</p>
					<div class="mt-8">
						@ui.ButtonLink("/", ui.Ghost) {
							Back home
						}
					</div>
				</div>
			}
		</div>
	}
}
