package views

// Feed is the explore feed with its three tabs, category chips and a search box
// (FR-FEED-1).
templ Feed(page FeedPage) {
	@Layout(page.Page) {
		@SiteHeader(page.Page)
		<main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 py-10">
			<h1 class="text-3xl font-bold tracking-tight">Frustrations ranked by urgency</h1>
			<p class="mt-2 max-w-2xl text-muted">
				Everyday problems people are tired of, ordered by how much they waste our time. Upvote the ones you recognise.
			</p>
			<nav aria-label="Feed view" class="mt-6 flex flex-wrap gap-2">
				@feedTab("trending", "Trending", page)
				@feedTab("latest", "Latest", page)
				@feedTab("most_voted", "Most voted", page)
			</nav>
			<form method="get" action="/" role="search" class="mt-6 flex flex-wrap items-center gap-2">
				<input type="hidden" name="tab" value={ page.Tab }/>
				if page.ActiveCategory != "" {
					<input type="hidden" name="category" value={ page.ActiveCategory }/>
				}
				<label for="feed-search" class="sr-only">Search frustrations</label>
				<input
					id="feed-search"
					type="search"
					name="q"
					value={ page.Search }
					maxlength="100"
					placeholder="Search frustrations..."
					class="w-full max-w-sm rounded-md border border-edge bg-surface px-3 py-1.5 text-sm text-ink placeholder:text-muted focus:outline-none focus-visible:ring-2 focus-visible:ring-brand"
				/>
				<button type="submit" class="rounded-md border border-edge px-3 py-1.5 text-sm text-muted transition hover:text-ink">Search</button>
			</form>
			<nav aria-label="Filter by category" class="mt-4 flex flex-wrap gap-2">
				<a href={ feedLink(page.Tab, "", page.Search, "") } class={ chipClass(page.ActiveCategory == "") }>All</a>
				for _, c := range page.Categories {
					<a href={ feedLink(page.Tab, c.Slug, page.Search, "") } class={ chipClass(c.Slug == page.ActiveCategory) }>{ c.Name }</a>
				}
			</nav>
			<div class="mt-8">
				if page.EmptyFeed {
					<p class="rounded-lg border border-dashed border-edge bg-surface p-8 text-center text-muted">
						Nothing has been posted in this view yet.
						<a href="/submit" class="text-brand underline underline-offset-4">Post the first frustration.</a>
					</p>
				} else {
					@PainList(page.Cards)
				}
			</div>
			@feedPagination(page)
		</main>
		@SiteFooter()
	}
}

templ feedTab(tab, label string, page FeedPage) {
	<a href={ feedLink(tab, page.ActiveCategory, page.Search, "") } class={ tabClass(tab == page.Tab) }>{ label }</a>
}

templ feedPagination(page FeedPage) {
	if page.HasCursor || page.HasNext {
		<nav aria-label="Pagination" class="mt-8 flex items-center justify-between text-sm">
			if page.HasCursor {
				<a href={ feedLink(page.Tab, page.ActiveCategory, page.Search, "") } class="text-brand underline underline-offset-4">Newer</a>
			} else {
				<span></span>
			}
			if page.HasNext {
				<a href={ feedLink(page.Tab, page.ActiveCategory, page.Search, page.NextCursor) } class="text-brand underline underline-offset-4">Older</a>
			}
		</nav>
	}
}
